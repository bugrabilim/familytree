{
  "expo": {
    "name": "Soy Ağacı",
    "slug": "familytree-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "familytree",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bugrabilim.familytree",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bugrabilim.familytree",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Soy Ağacı to access Face ID."
        }
      ]
    ]
  }
}
