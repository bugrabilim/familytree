# ── Kimlik / Oturum ─────────────────────────────────────────────────────────
# NextAuth v5 gizli anahtarı (NEXTAUTH_SECRET DEĞİL): openssl rand -hex 32
AUTH_SECRET=your-secret-run-openssl-rand-hex-32

# Sitenin kanonik kök URL'i — OG/paylaşım kartları, sitemap, robots için.
# Vercel'de otomatik VERCEL_PROJECT_PRODUCTION_URL'e düşer; gerçek alan adı
# bağlanınca burayı ayarla (ör. https://soyagaci.app).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Depolama: Vercel Blob (aile verisinin ana kaynağı) ──────────────────────
# Vercel dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Medya: Cloudinary (fotoğraf/video/ses) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Yapay zekâ: Google Gemini (opsiyonel; yoksa AI özellikleri kapalı) ───────
# Anahtar: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash   # opsiyonel; varsayılan koddadır

# ── E-posta (opsiyonel; yoksa hatırlatma/bildirim gönderimi kapalı) ──────────
# Sağlayıcı: Resend (ücretsiz katman). Alan adını (ör. soylus.com) doğrula.
# Ayrıntı: docs/EPOSTA-PLANI.md
# RESEND_API_KEY=re_...
# EMAIL_FROM=Soylus <bilgi@soylus.com>
# EMAIL_REPLY_TO=...   # Yanıtların OKUNACAĞI adres (madde 51 sırasında eklendi)
#   Gönderen alan adını doğrulamak yalnız GÖNDERMEYE yetki verir; EMAIL_FROM
#   adresinin bir posta kutusu olmak zorunda değil. Bu değişken yokken aile
#   üyesinin hatırlatmaya verdiği yanıt hiçbir yere ulaşmıyor — sessizce
#   kaybolan bir geri bildirim kanalı. Gerçekten okunan bir adres yazın.
# CRON_SECRET=...   # Vercel Cron isteklerini doğrulamak için rastgele dize
#   ZORUNLU: tanımsızsa cron uçları KAPALI DÜŞER (401) ve hatırlatma/yedek
#   işleri hiç koşmaz. /api/cron/backup bütün blob deposunu okuyup yazdığı
#   için "sır yoksa serbest" davranışı kabul edilebilir değil.
# BACKUP_KEEP_DAYS=14   # Kaç GÜNLÜK yedek görüntüsü saklanacak (bkz. docs/YEDEKLEME.md)

# ── Veritabanı: Supabase (çift-yazma aynası + ileride birincil) ─────────────
# Vercel-Supabase entegrasyonu çoğunu otomatik enjekte eder. Gerekenler:
#   SUPABASE_URL veya NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY veya SUPABASE_SECRET_KEY (sunucu; RLS atlar)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY (Supabase üzerinden giriş için)
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# ── Opsiyonel Auth göçü ─────────────────────────────────────────────────────
# Kurucu girişi Supabase Auth'tan doğrulansın mı (varsayılan kapalı; bkz. docs).
# AÇIKKEN kurucunun bcrypt yolu kendiliğinden KAPANIR — Faz 4'ün asıl adımı bu.
# SUPABASE_AUTH_LOGIN=1
#
# ACİL DURUM ANAHTARI: Supabase Auth kesintisinde kurucu girişini bcrypt'e geri
# açar. Kalıcı bir ayar değil; kesinti bitince KALDIRILMALI.
#   · SUPABASE_AUTH_LOGIN kapalıyken bu değişkenin hiçbir etkisi yoktur —
#     o durumda bcrypt zaten tek yol ve kapatılamaz (kilitlenme imkânsız).
#   · Üye (davetli) girişi hiçbir zaman bu bayrağa bağlı değildir; üyelerin
#     Supabase Auth kaydı yok, girişleri her koşulda bcrypt'ten doğrulanır.
# AUTH_BCRYPT_FALLBACK=1
#
# ACİL DURUM ANAHTARI: kimlik OKUMALARINI Blob'a geri alır (Faz 4 / 2b-2).
# Varsayılan davranış artık Postgres aynasından okumak; ayna okunamazsa,
# boşsa ya da satır yarımsa zaten Blob'a düşülüyor. Bu değişken o otomatik
# geri düşüşü beklemeden okumayı tümüyle Blob'a çevirir.
# YAZMA yolu bundan etkilenmez; onun ayrı anahtarı var (aşağıda).
# IDENTITY_READ_BLOB=1
#
# ACİL DURUM ANAHTARI: kimlik YAZMALARINI Blob'a geri alır (Faz 4 / 2c-2).
# Varsayılan davranış artık Postgres'te TEK SATIRA yazmak; `users.json` her
# başarılı yazmadan sonra aynadan yeniden kuruluyor (best-effort kopya).
# Bu değişken eski davranışı geri getirir: Blob'u oku-değiştir-yaz + Postgres
# aynası.
# NEDEN AYRI BİR ANAHTAR: okuma ve yazma tek bayrağa bağlansaydı, yalnız
# yazmada bir sorun görüldüğünde okuma da geri alınmak zorunda kalırdı.
# Supabase hiç yapılandırılmamışsa (yerel geliştirme) bu bayrak ARANMADAN
# Blob asıl kaynak kalır — olmayan bir aynaya yazmayı denemek yerelde her
# kimlik işlemini öldürürdü.
# IDENTITY_WRITE_BLOB=1
#
# Sentetik iç e-posta alan adı (varsayılan hesap.soyagaci.local).
# AUTH_INTERNAL_EMAIL_DOMAIN=hesap.soyagaci.local

# ── Gelen posta (bilgi@soylus.com) ───────────────────────────────────────────
#
# UYGULAMA İÇİNDE GELEN KUTUSU YOK — bilerek. Bir süre vardı (webhook + imza
# doğrulama + depo + ekran) ve çalışıyordu, ama yanlış işti: hazır e-posta
# hizmetlerinin ücretsiz olarak çözdüğü bir problemi elde çözüyordu ve her
# adımda yeni bir kenar durum çıkarıyordu (HTML temizleme, gövdeyi ayrı
# çağrıyla çekme, yarış koşulları, imza sırrı).
#
# Şimdiki kurulum, ortam değişkeni GEREKTİRMİYOR — hepsi DNS'te ve Gmail'de:
#
#  1. GELEN: `soylus.com` MX kayıtları ImprovMX'e bakıyor (ücretsiz plan);
#     ImprovMX `bilgi@soylus.com`a geleni bir Gmail hesabına yönlendiriyor.
#     Spam klasörü, mobil uygulama, arama — hepsi Gmail'den geliyor.
#  2. GİDEN: Gmail'in "şu adresten gönder" özelliği Resend SMTP'sine bağlı
#     (`smtp.resend.com`, kullanıcı adı düz `resend`, parola bir Resend API
#     anahtarı). Yani cevaplar `bilgi@soylus.com` adından çıkıyor ve
#     doğrulanmış alan adımızla imzalanıyor.
#
# Uygulamanın kendi giden postası (yukarıdaki RESEND_API_KEY / EMAIL_FROM)
# bundan bağımsız ve değişmedi: hatırlatmalar, davetler ve doğrulama
# postaları yine Resend API'siyle gidiyor.
