# ── Kimlik / Oturum ─────────────────────────────────────────────────────────
# NextAuth v5 gizli anahtarı (NEXTAUTH_SECRET DEĞİL): openssl rand -hex 32
AUTH_SECRET=your-secret-run-openssl-rand-hex-32

# Sitenin kanonik kök URL'i — OG/paylaşım kartları, sitemap, robots için.
# Vercel'de otomatik VERCEL_PROJECT_PRODUCTION_URL'e düşer; gerçek alan adı
# bağlanınca burayı ayarla (ör. https://soyagaci.app).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Depolama: Vercel Blob (aile verisinin ana kaynağı) ──────────────────────
# Vercel dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Medya: Cloudinary (fotoğraf/video/ses) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Yapay zekâ: Google Gemini (opsiyonel; yoksa AI özellikleri kapalı) ───────
# Anahtar: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash   # opsiyonel; varsayılan koddadır

# ── E-posta (opsiyonel; yoksa hatırlatma/bildirim gönderimi kapalı) ──────────
# Sağlayıcı: Resend (ücretsiz katman). Alan adını (ör. soylus.com) doğrula.
# Ayrıntı: docs/EPOSTA-PLANI.md
# RESEND_API_KEY=re_...
# EMAIL_FROM=Soylus <bilgi@soylus.com>
# EMAIL_REPLY_TO=...   # Yanıtların OKUNACAĞI adres (madde 51 sırasında eklendi)
#   Gönderen alan adını doğrulamak yalnız GÖNDERMEYE yetki verir; EMAIL_FROM
#   adresinin bir posta kutusu olmak zorunda değil. Bu değişken yokken aile
#   üyesinin hatırlatmaya verdiği yanıt hiçbir yere ulaşmıyor — sessizce
#   kaybolan bir geri bildirim kanalı. Gerçekten okunan bir adres yazın.
# CRON_SECRET=...   # Vercel Cron isteklerini doğrulamak için rastgele dize
#   ZORUNLU: tanımsızsa cron uçları KAPALI DÜŞER (401) ve hatırlatma/yedek
#   işleri hiç koşmaz. /api/cron/backup bütün blob deposunu okuyup yazdığı
#   için "sır yoksa serbest" davranışı kabul edilebilir değil.
# BACKUP_KEEP_DAYS=14   # Kaç GÜNLÜK yedek görüntüsü saklanacak (bkz. docs/YEDEKLEME.md)

# ── Veritabanı: Supabase (çift-yazma aynası + ileride birincil) ─────────────
# Vercel-Supabase entegrasyonu çoğunu otomatik enjekte eder. Gerekenler:
#   SUPABASE_URL veya NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY veya SUPABASE_SECRET_KEY (sunucu; RLS atlar)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY (Supabase üzerinden giriş için)
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# ── Opsiyonel Auth göçü ─────────────────────────────────────────────────────
# Giriş doğrulaması Supabase Auth'u DENESİN mi (varsayılan kapalı; bkz. docs).
# SUPABASE_AUTH_LOGIN=1
# Sentetik iç e-posta alan adı (varsayılan hesap.soyagaci.local).
# AUTH_INTERNAL_EMAIL_DOMAIN=hesap.soyagaci.local
