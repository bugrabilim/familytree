# ── Kimlik / Oturum ─────────────────────────────────────────────────────────
# NextAuth v5 gizli anahtarı (NEXTAUTH_SECRET DEĞİL): openssl rand -hex 32
AUTH_SECRET=your-secret-run-openssl-rand-hex-32

# Sitenin kanonik kök URL'i — OG/paylaşım kartları, sitemap, robots için.
# Vercel'de otomatik VERCEL_PROJECT_PRODUCTION_URL'e düşer; gerçek alan adı
# bağlanınca burayı ayarla (ör. https://soyagaci.app).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Depolama: Vercel Blob (aile verisinin ana kaynağı) ──────────────────────
# Vercel dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Medya: Cloudinary (fotoğraf/video/ses) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Yapay zekâ: Google Gemini (opsiyonel; yoksa AI özellikleri kapalı) ───────
# Anahtar: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash   # opsiyonel; varsayılan koddadır

# ── E-posta (opsiyonel; yoksa hatırlatma/bildirim gönderimi kapalı) ──────────
# Sağlayıcı: Resend (ücretsiz katman). Alan adını (ör. soylus.com) doğrula.
# Ayrıntı: docs/EPOSTA-PLANI.md
# RESEND_API_KEY=re_...
# EMAIL_FROM=Soylus <bilgi@soylus.com>
# EMAIL_REPLY_TO=...   # Yanıtların OKUNACAĞI adres (madde 51 sırasında eklendi)
#   Gönderen alan adını doğrulamak yalnız GÖNDERMEYE yetki verir; EMAIL_FROM
#   adresinin bir posta kutusu olmak zorunda değil. Bu değişken yokken aile
#   üyesinin hatırlatmaya verdiği yanıt hiçbir yere ulaşmıyor — sessizce
#   kaybolan bir geri bildirim kanalı. Gerçekten okunan bir adres yazın.
# CRON_SECRET=...   # Vercel Cron isteklerini doğrulamak için rastgele dize
#   ZORUNLU: tanımsızsa cron uçları KAPALI DÜŞER (401) ve hatırlatma/yedek
#   işleri hiç koşmaz. /api/cron/backup bütün blob deposunu okuyup yazdığı
#   için "sır yoksa serbest" davranışı kabul edilebilir değil.
# BACKUP_KEEP_DAYS=14   # Kaç GÜNLÜK yedek görüntüsü saklanacak (bkz. docs/YEDEKLEME.md)

# ── Veritabanı: Supabase (çift-yazma aynası + ileride birincil) ─────────────
# Vercel-Supabase entegrasyonu çoğunu otomatik enjekte eder. Gerekenler:
#   SUPABASE_URL veya NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY veya SUPABASE_SECRET_KEY (sunucu; RLS atlar)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY (Supabase üzerinden giriş için)
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# ── Opsiyonel Auth göçü ─────────────────────────────────────────────────────
# Giriş doğrulaması Supabase Auth'u DENESİN mi (varsayılan kapalı; bkz. docs).
# SUPABASE_AUTH_LOGIN=1
# Sentetik iç e-posta alan adı (varsayılan hesap.soyagaci.local).
# AUTH_INTERNAL_EMAIL_DOMAIN=hesap.soyagaci.local

# ── Gelen posta (bilgi@soylus.com) ───────────────────────────────────────────
#
# Sağlayıcıdaki (Resend) "Inbound" özelliği, gelen her postayı
# `POST /api/inbound/resend` adresine iletir. İki şey gerekiyor:
#
#  1. DNS'te bir MX kaydı (sağlayıcının panelinde gösterilen değer).
#  2. Aşağıdaki imza sırrı. YOKSA UÇ KAPALI DÜŞER ve hiçbir posta kaydedilmez
#     — bilerek: imzasız bir uçta "gelen posta" uydurmak serbest olurdu.
# RESEND_WEBHOOK_SECRET=whsec_...
#
#  3. `RESEND_API_KEY` OKUMA yetkisi taşımalı ("Full access"). Sağlayıcının
#     webhook bildirimi postanın GÖVDESİNİ taşımıyor (bilerek: sunucusuz
#     ortamların istek boyutu sınırları var); gövde ayrı bir çağrıyla
#     alınıyor: GET /emails/receiving/<email_id>.
#
#     Yalnız gönderim yetkisi olan bir anahtarla posta yine de KUTUYA DÜŞER,
#     ama gövdesi boş kalır ve ekran nedenini söyler. Anahtar sonradan
#     değiştirilirse posta açıldığında gövde kendiliğinden tamamlanır —
#     yeniden posta göndermeye gerek yok.
#
# Gelen kutusunu (`/admin/posta`) OKUYABİLEN hesap kimlikleri, virgül ayraçlı.
# Boşsa HİÇ KİMSE okuyamaz. `isFounder` burada yetmez: bu depoda her kullanıcı
# kendi ağacının kurucusudur, yani onunla korunsaydı kaydolan herkes
# yabancıların bize yazdığı postaları okurdu.
# Kendi kimliğini görmek için giriş yapıp /admin/posta adresini aç: yetkisizken
# ekran sana kendi hesap kimliğini gösterir.
# ADMIN_ACCOUNT_IDS=
#
# Gelen postanın İLETİLECEĞİ kendi adresin — virgülle birden fazla yazılabilir.
# Boşsa iletme kapalıdır ve postayı okumak için /admin/posta sayfasına girmek
# gerekir; girilmediği için de posta okunmaz. Bir gelen kutusunun değeri
# gelenden HABERDAR olmakta, arşivinde değil.
#
# İletilen posta KENDİ adresimizden çıkar (başkasının adresini `From`a yazmak
# SPF/DKIM'de düşer), ama görünen ad özgün göndereni söyler ve `Reply-To` ona
# ayarlanır: "Yanıtla" demek doğrudan yazan kişiye yazmak demektir.
#
# Buraya yazılan adres `bilgi@soylus.com`a otomatik yanıt veriyorsa (tatil
# yanıtlayıcısı gibi) sonsuz döngü olurdu; gönderen iletme adresiyse posta
# bilerek iletilmiyor.
# INBOX_FORWARD_TO=
